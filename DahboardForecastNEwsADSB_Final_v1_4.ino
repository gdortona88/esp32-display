  void drawForecast() {
    font(); text(12,130,String("Local sensor")+(sensor.failed ? " / STALE" : "")+" | hold KEY: graph");
    auto &c=cache[FORECAST];
    if(!c.valid)wrapped(12,169,c.error,375,3);
    else for(int i=0;i<c.result.count;++i){auto &d=c.result.data.forecast.days[i];int x=12+i*128;
      text(x,153,String(d.date+5));weatherIcon(x+18,177,d.code);
      text(x+37,182,weatherLabel(d.code));
      text(x,211,String(d.low,0)+" / "+String(d.high,0)+" C");
      text(x,232,String(d.rain)+"% rain");}
    text(12,263,String("Open-Meteo | ")+(stale(FORECAST)?"STALE ":"Updated ")+age(c.successMs));
  }
  const Route *findRoute(const char *callsign) {
    for(auto &r:routes)if(r.expires>ms()&&!strcmp(r.route.callsign,callsign))return &r.route;
    return nullptr;
  }
  const char *nextRouteCallsign(bool respectCooldown=true) {
    auto &c=cache[PLANES];if(!c.valid||!c.result.count||(respectCooldown&&ms()<routeRetry))return nullptr;
    for(uint8_t offset=0;offset<c.result.count;++offset){auto &p=c.result.data.planes[(selectedPlane+offset)%c.result.count];if(p.hasCallsign&&!findRoute(p.callsign))return p.callsign;}
    return nullptr;
  }
  void acceptRoute(const Result &result) {
    int slot=0;
    for(int i=0;i<24;++i){if(!strcmp(routes[i].route.callsign,result.data.route.callsign)){slot=i;break;}if(routes[i].expires<routes[slot].expires)slot=i;}
    auto &entry=routes[slot];bool same=!strcmp(entry.route.callsign,result.data.route.callsign);
    uint8_t failures=same?entry.failures:0;entry.route=result.data.route;
    uint64_t ttl=21600000ULL;
    if(result.ok){entry.failures=0;if(entry.route.state==ROUTE_PARTIAL)ttl=900000ULL;}
    else if(result.httpStatus==404){entry.route.state=ROUTE_UNLISTED;entry.failures=0;ttl=1800000ULL;}
    else {entry.route.state=ROUTE_ERROR;entry.failures=failures<4?failures+1:4;ttl=60000ULL<<(entry.failures-1);}
    entry.expires=ms()+max(ttl,uint64_t(result.retryAfter)*1000);
    routeRetry=ms()+max(result.ok||result.httpStatus==404?2000ULL:10000ULL,uint64_t(result.retryAfter)*1000);
    routeInFlight[0]=0;
  }
  void drawTransport() {
    font(); text(12, 55, fit(cfg.stop[0] ? cfg.stop : "Configure a Prague stop", 375));
    if (!cfg.token[0]) { wrapped(12, 92, "Add a free Golemio API key in setup to enable departures.", 370, 3); }
    else if (!cache[DEPARTURES].valid) { wrapped(12, 94, cache[DEPARTURES].error, 370, 4); }
    else {
      auto &r = cache[DEPARTURES].result;
      if (!r.count) text(12, 100, "No departures in next 60 minutes");
      for (int i = 0; i < r.count && i < 5; ++i) {
        auto &d = r.data.departures[i]; int y = 84 + i * 30;
        g->drawFrame(12, y - 19, 49, 25); text(16, y, fit(d.line, 41));
        text(70, y, fit(d.destination, 225));
        long delta = d.when - time(nullptr);
        String due = delta < -30 ? "left" : delta < 30 ? "now" : String((delta + 59) / 60) + "m";
        if (!timeValid() || stale(DEPARTURES)) { struct tm t{}; localtime_r(&d.when, &t); char b[8]; strftime(b, sizeof(b), "%H:%M", &t); due = b; }
        text(313, y, due); if (d.live) g->drawDisc(389, y - 6, 2);
      }
    }
    cacheFooter(DEPARTURES, "PID / Golemio");
  }
