class ST7305_U8g2 {
private:
  int _sck;
  int _mosi;
  int _dc;
  int _cs;
  int _rst;
  SPIClass *_spi = nullptr;
  U8G2 u8g2_wrapper;
  uint8_t *_my_buf = nullptr;

  void _cmd(uint8_t cmd);
  void _data(const uint8_t *data, size_t len);
  void _cmd_data(uint8_t cmd, const uint8_t *data, size_t len);

  static uint8_t u8x8_d_st7305_custom(u8x8_t *u8x8, uint8_t msg, uint8_t arg_int, void *arg_ptr);
  static uint8_t u8x8_byte_custom(u8x8_t *u8x8, uint8_t msg, uint8_t arg_int, void *arg_ptr);

public:
  ST7305_U8g2(int sck = 11, int mosi = 12, int dc = 5, int cs = 40, int rst = 41);
  ~ST7305_U8g2();

  // tile_buf_height 0 means full-buffer mode, about 15 KB RAM for 300x400.
  // A smaller value can be used with firstPage()/nextPage(), but this demo uses full-buffer mode.
  void begin(uint8_t tile_buf_height = 0, const u8g2_cb_t *rotation = U8G2_R0);
  void reset();
  void setInverted(bool enabled) { _cmd(enabled ? 0x20 : 0x21); } // Toggle the vendor default polarity.
  void fullInit();

  U8G2 *getU8g2()
  {
    return &u8g2_wrapper;
  }
};


#define SPI_CLK 24000000
#define ST7305_TILE_WIDTH 38
#define ST7305_TILE_HEIGHT 50
#define ST7305_BUFFER_ROW_BYTES (ST7305_TILE_WIDTH * 8)

static ST7305_U8g2 *g_lcd_instance = nullptr;

static u8x8_display_info_t st7305_display_info = {
  /* chip_enable_level = */ 0,
  /* chip_disable_level = */ 1,
  /* post_chip_enable_wait_ns = */ 0,
  /* pre_chip_disable_wait_ns = */ 0,
  /* reset_pulse_width_ms = */ 20,
  /* post_reset_wait_ms = */ 50,
  /* sda_setup_time_ns = */ 0,
  /* sck_pulse_width_ns = */ 0,
  /* sck_clock_hz = */ SPI_CLK,
  /* spi_mode = */ 0,
  /* i2c_bus_clock_100kHz = */ 4,
  /* data_setup_time_ns = */ 0,
  /* write_pulse_width_ns = */ 0,
  /* tile_width = */ ST7305_TILE_WIDTH,
  /* tile_height = */ ST7305_TILE_HEIGHT,
  /* default_x_offset = */ 0,
  /* flip_mode_x_offset = */ 0,
  /* pixel_width = */ 300,
  /* pixel_height = */ 400
};

ST7305_U8g2::ST7305_U8g2(int sck, int mosi, int dc, int cs, int rst)
  : _sck(sck), _mosi(mosi), _dc(dc), _cs(cs), _rst(rst)
{
  _spi = new SPIClass(HSPI);
  g_lcd_instance = this;
}

ST7305_U8g2::~ST7305_U8g2()
{
  if (_spi) {
    _spi->end();
    delete _spi;
  }
  if (_my_buf) {
    free(_my_buf);
  }
  if (g_lcd_instance == this) {
    g_lcd_instance = nullptr;
  }
}

void ST7305_U8g2::_cmd(uint8_t cmd)
{
  digitalWrite(_dc, LOW);
  digitalWrite(_cs, LOW);
  _spi->transfer(cmd);
  digitalWrite(_cs, HIGH);
}

void ST7305_U8g2::_data(const uint8_t *data, size_t len)
{
  digitalWrite(_dc, HIGH);
  digitalWrite(_cs, LOW);
  _spi->transferBytes((uint8_t *)data, nullptr, len);
  digitalWrite(_cs, HIGH);
}

void ST7305_U8g2::_cmd_data(uint8_t cmd, const uint8_t *data, size_t len)
{
  digitalWrite(_dc, LOW);
  digitalWrite(_cs, LOW);
  _spi->transfer(cmd);
  if (len > 0) {
    digitalWrite(_dc, HIGH);
    _spi->transferBytes((uint8_t *)data, nullptr, len);
  }
  digitalWrite(_cs, HIGH);
}

void ST7305_U8g2::reset()
{
  digitalWrite(_rst, HIGH);
  delay(50);
  digitalWrite(_rst, LOW);
  delay(20);
  digitalWrite(_rst, HIGH);
  delay(50);
}

uint8_t ST7305_U8g2::u8x8_byte_custom(u8x8_t *u8x8, uint8_t msg, uint8_t arg_int, void *arg_ptr)
{
  (void)u8x8;
  (void)arg_int;
  (void)arg_ptr;

  switch (msg) {
    case U8X8_MSG_BYTE_INIT:
    case U8X8_MSG_BYTE_START_TRANSFER:
    case U8X8_MSG_BYTE_END_TRANSFER:
    case U8X8_MSG_BYTE_SET_DC:
    case U8X8_MSG_BYTE_SEND:
    default:
      return 1;
  }
}

uint8_t ST7305_U8g2::u8x8_d_st7305_custom(u8x8_t *u8x8, uint8_t msg, uint8_t arg_int, void *arg_ptr)
{
  (void)arg_int;

  if (!g_lcd_instance) {
    return 0;
  }

  switch (msg) {
    case U8X8_MSG_DISPLAY_SETUP_MEMORY:
      u8x8_d_helper_display_setup_memory(u8x8, &st7305_display_info);
      break;

    case U8X8_MSG_DISPLAY_INIT:
      g_lcd_instance->fullInit();
      break;

    case U8X8_MSG_DISPLAY_DRAW_TILE: {
      u8x8_tile_t *tile = (u8x8_tile_t *)arg_ptr;
      uint8_t cnt = tile->cnt;
      uint8_t y_pos = tile->y_pos;
      uint8_t x_pos = tile->x_pos;

      int first_col = x_pos * 8;
      int last_col = (x_pos + cnt) * 8 - 1;
      if (last_col >= 300) {
        last_col = 299;
      }

      int addr_start = 0x12 + first_col / 12;
      int addr_end = 0x12 + last_col / 12;
      int send_start = (addr_start - 0x12) * 3;
      int send_cnt = (addr_end - addr_start + 1) * 3;

      int addr_first_col = (addr_start - 0x12) * 12;
      int addr_last_col = (addr_end - 0x12) * 12 + 11;
      if (addr_last_col >= 300) {
        addr_last_col = 299;
      }

      uint8_t *row_base = tile->tile_ptr - ((uint16_t)x_pos * 8U);

      uint8_t col_bounds[] = {(uint8_t)(0x3C - addr_end), (uint8_t)(0x3C - addr_start)};
      g_lcd_instance->_cmd_data(0x2A, col_bounds, sizeof(col_bounds));

      uint8_t row_bounds[] = {(uint8_t)(y_pos * 4), (uint8_t)(y_pos * 4 + 3)};
      g_lcd_instance->_cmd_data(0x2B, row_bounds, sizeof(row_bounds));

      static const uint8_t st_lut[4][4] = {
        {0x00, 0x80, 0x40, 0xC0},
        {0x00, 0x20, 0x10, 0x30},
        {0x00, 0x08, 0x04, 0x0C},
        {0x00, 0x02, 0x01, 0x03},
      };

      uint8_t all_rows[300] = {0};
      for (int sr = 0; sr < 4; sr++) {
        int shift = sr * 2;
        int base_off = sr * send_cnt;
        int idx = base_off + (addr_first_col >> 2) - send_start;

        for (int col = addr_first_col; col <= addr_last_col; col += 4, idx++) {
          all_rows[idx] = st_lut[0][(row_base[col] >> shift) & 3]
                        | st_lut[1][(row_base[col + 1] >> shift) & 3]
                        | st_lut[2][(row_base[col + 2] >> shift) & 3]
                        | st_lut[3][(row_base[col + 3] >> shift) & 3];
        }
      }

      g_lcd_instance->_cmd_data(0x2C, all_rows, (size_t)send_cnt * 4U);
      break;
    }

    default:
      return 0;
  }

  return 1;
}

void ST7305_U8g2::begin(uint8_t tile_buf_height, const u8g2_cb_t *rotation)
{
  pinMode(_dc, OUTPUT);
  pinMode(_cs, OUTPUT);
  pinMode(_rst, OUTPUT);
  digitalWrite(_cs, HIGH);
  digitalWrite(_dc, HIGH);
  digitalWrite(_rst, HIGH);

  _spi->begin(_sck, -1, _mosi, -1);
  _spi->beginTransaction(SPISettings(SPI_CLK, MSBFIRST, SPI_MODE0));

  u8g2_t *u = u8g2_wrapper.getU8g2();
  u8x8_Setup(u8g2_GetU8x8(u), u8x8_d_st7305_custom, u8x8_dummy_cb, u8x8_byte_custom, u8x8_dummy_cb);

  uint8_t tbh = tile_buf_height == 0 ? ST7305_TILE_HEIGHT : tile_buf_height;
  if (tbh > ST7305_TILE_HEIGHT) {
    tbh = ST7305_TILE_HEIGHT;
  }

  size_t buf_sz = ST7305_BUFFER_ROW_BYTES * tbh;
  _my_buf = (uint8_t *)malloc(buf_sz);
  if (!_my_buf) {
    return;
  }
  memset(_my_buf, 0, buf_sz);

  u8g2_SetupBuffer(u, _my_buf, tbh, u8g2_ll_hvline_vertical_top_lsb, rotation);
  u8g2_InitDisplay(u);
  u8g2_SetPowerSave(u, 0);
}

void ST7305_U8g2::fullInit()
{
  reset();

  const uint8_t d6[] = {0x17, 0x02};
  const uint8_t d1[] = {0x01};
  const uint8_t c0[] = {0x11, 0x04};
  const uint8_t c1[] = {0x69, 0x69, 0x69, 0x69};
  const uint8_t c2[] = {0x19, 0x19, 0x19, 0x19};
  const uint8_t c4[] = {0x4B, 0x4B, 0x4B, 0x4B};
  const uint8_t d8[] = {0x80, 0xE9};
  const uint8_t b2[] = {0x02};
  const uint8_t b3[] = {0xE5, 0xF6, 0x05, 0x46, 0x77, 0x77, 0x77, 0x77, 0x76, 0x45};
  const uint8_t b4[] = {0x05, 0x46, 0x77, 0x77, 0x77, 0x77, 0x76, 0x45};
  const uint8_t g_timing[] = {0x32, 0x03, 0x1F};
  const uint8_t b7[] = {0x13};
  const uint8_t b0[] = {0x64};
  const uint8_t c9[] = {0x00};
  const uint8_t m36[] = {0x48};
  const uint8_t m3a[] = {0x11};
  const uint8_t b9[] = {0x20};
  const uint8_t b8[] = {0x29};
  const uint8_t win_a[] = {0x12, 0x2A};
  const uint8_t win_b[] = {0x00, 0xC7};
  const uint8_t m35[] = {0x00};
  const uint8_t d0[] = {0xFF};

  _cmd_data(0xD6, d6, sizeof(d6));
  _cmd_data(0xD1, d1, sizeof(d1));
  _cmd_data(0xC0, c0, sizeof(c0));
  _cmd_data(0xC1, c1, sizeof(c1));
  _cmd_data(0xC2, c2, sizeof(c2));
  _cmd_data(0xC4, c4, sizeof(c4));
  _cmd_data(0xC5, c2, sizeof(c2));
  _cmd_data(0xD8, d8, sizeof(d8));
  _cmd_data(0xB2, b2, sizeof(b2));
  _cmd_data(0xB3, b3, sizeof(b3));
  _cmd_data(0xB4, b4, sizeof(b4));
  _cmd_data(0x62, g_timing, sizeof(g_timing));
  _cmd_data(0xB7, b7, sizeof(b7));
  _cmd_data(0xB0, b0, sizeof(b0));
  _cmd(0x11);
  delay(120);
  _cmd_data(0xC9, c9, sizeof(c9));
  _cmd_data(0x36, m36, sizeof(m36));
  _cmd_data(0x3A, m3a, sizeof(m3a));
  _cmd_data(0xB9, b9, sizeof(b9));
  _cmd_data(0xB8, b8, sizeof(b8));
  _cmd(0x21);
  _cmd_data(0x2A, win_a, sizeof(win_a));
  _cmd_data(0x2B, win_b, sizeof(win_b));
  _cmd_data(0x35, m35, sizeof(m35));
  _cmd_data(0xD0, d0, sizeof(d0));
  _cmd(0x38);
  _cmd(0x29);
}

// ============================================================
// APPLICATION DEPENDENCIES AND SINGLE-FILE ARCHITECTURE
// Main task owns UI, I2C, buttons, NVS, Wi-Fi lifecycle and portal.
// A worker receives immutable job copies and returns fixed-size results.
// It never touches the display, configuration, or shared cache directly.
// ============================================================
// Flash-resident offline stop data is in Appendix A, after setup()/loop().
extern const char STOP_CATALOGUE[] PROGMEM;

class Dashboard {
  // ============================================================
  // CONFIGURATION AND APP MODELS
  // ============================================================
  static constexpr uint32_t CONFIG_MAGIC = 0x524C4401;
  static constexpr const char *VERSION = "1.4.0";
  enum App { CLOCK, WEATHER, TRANSPORT, AIRCRAFT, NEWS, SYSTEM, APP_COUNT };
  enum JobKind { DEPARTURES, PLANES, HEADLINES, FORECAST, ROUTE, GEOCODE };
  struct Config {
    uint32_t magic;
    char ssid[33], wifiPassword[65], setupCode[17];
    char timezone[96], location[65], stop[97], token[768], feed[257];
    double latitude, longitude;
    float temperatureOffset;
    uint32_t sensorSeconds, transportSeconds, aircraftSeconds, newsSeconds;
    uint16_t radiusKm;
    bool sleepEnabled; // Legacy NVS layout field; ignored in v1.0.1.
  } cfg{};
  struct Departure { char line[16], destination[128]; time_t when; bool live; };
  struct Plane {
    char callsign[20], type[12], altitude[20], origin[12], destination[12];
    float distance, bearing, track;
    bool hasCallsign;
  };
  struct ForecastDay { char date[11]; float low, high; int rain, code; };
  struct ForecastHour { int64_t epoch; float temperature; int rain, code; bool daytime; };
  struct ForecastData { ForecastDay days[3]; ForecastHour hours[24]; uint8_t hourCount; };
  enum RouteState { ROUTE_NONE, ROUTE_FOUND, ROUTE_PARTIAL, ROUTE_UNLISTED, ROUTE_ERROR };
  struct Route { char callsign[20], origin[12], destination[12], from[48], to[48]; bool found; RouteState state; };
  struct RouteEntry { Route route{}; uint64_t expires=0; uint8_t failures=0; } routes[24];
  char routeInFlight[20]{};
  uint64_t routeRetry=0, carouselAt=0, animationAt=0;
  bool inverted=false;
  struct Place { char label[256]; double latitude, longitude; };
  struct Result {
    JobKind kind;
    bool ok;
    uint8_t count;
    uint32_t retryAfter;
    uint16_t httpStatus;
    char error[72];
    union { Departure departures[6]; Plane planes[6]; char headlines[5][200]; ForecastData forecast; Route route; Place places[5]; } data;
  };
  struct Job { JobKind kind; Config config; char callsign[20]; char query[161]; };
  Result geoResult{};
  bool geoPending=false,geoRunning=false;
  char geoQuery[161]{};
  uint32_t geoId=0;
  uint64_t geoStarted=0,geoRetry=0;
  struct Cache {
    Result result{};
    uint64_t successMs = 0, attemptMs = 0, retryMs = 0;
    bool valid = false;
    uint8_t failures = 0;
    char error[72] = "Waiting for update";
  } cache[4];
  struct Button {
    uint8_t pin;
    bool raw = false, down = false, held = false;
    uint64_t changed = 0, pressed = 0;
  } nextButton{18}, backButton{0};
  struct Sensor {
    float temperature = NAN, humidity = NAN, minimum = NAN, maximum = NAN;
    float history[48]{};
    uint8_t count = 0, head = 0;
    uint64_t sampled = 0, attempted = 0;
    bool failed = true;
  } sensor;
  ST7305_U8g2 lcd;
  U8G2 *g = nullptr;
  uint8_t previousFrame[15200]{};
  WebServer server{80};
  DNSServer dns;
  Preferences preferences;
  QueueHandle_t jobs = nullptr, results = nullptr;
  App app = CLOCK;
  bool dirty = true, portal = false, portalRequested = false, connecting = false;
  bool networkUp = false, jobBusy = false, rtcPresent = false, rtcValid = false;
  bool uploadActive = false, uploadOK = false, uploadAuthorized = false;
  bool alternate = false, ntpSession = false;
  bool tcpipReady = false, ntpRunning = false;
  uint8_t selectedPlane = 0;
  uint64_t portalStarted = 0, connectStarted = 0, connectedAt = 0;
  uint64_t networkRetry = 0, ntpAttempt = 0, lastAction = 0, lastUiTick = 0;
  uint64_t lastBattery = 0, lastNetworkSuccess = 0, uploadStarted = 0;
  uint64_t rebootAt = 0;
  uint64_t lastDiagnostic = 0;
  uint32_t stripWrites = 0;
  int bootResetReason = 0;
  float batteryVoltage = NAN;
  int batteryPercent = -1, lastRssi = 0;
  char lastIP[20] = "--", apName[32]{}, csrf[33]{};
  char status[80] = "Starting";
  std::atomic<bool> timeArrived{false};
  inline static Dashboard *instance = nullptr;

  static uint64_t ms() { return esp_timer_get_time() / 1000ULL; }
  static bool timeValid() { return time(nullptr) >= 1704067200 && time(nullptr) < 4102444800LL; }
  static void copy(char *dst, size_t size, const char *src) { snprintf(dst, size, "%s", src ? src : ""); }
  static void randomText(char *dst, size_t digits) {
    const char *hex = "0123456789abcdef";
    for (size_t i = 0; i < digits; ++i) dst[i] = hex[esp_random() & 15];
    dst[digits] = 0;
  }
  static String escape(const String &s) {
    String out; out.reserve(s.length() + 32);
    for (size_t i = 0; i < s.length(); ++i) {
      char c = s[i];
      if (c == '&') out += "&amp;"; else if (c == '<') out += "&lt;";
      else if (c == '>') out += "&gt;"; else if (c == '"') out += "&quot;";
      else if (c == '\'') out += "&#39;"; else out += c;
    }
    return out;
  }
  static String urlEncode(const char *s) {
    String out; const char *hex = "0123456789ABCDEF";
    for (; *s; ++s) {
      uint8_t c = (uint8_t)*s;
      if (isalnum(c) || c == '-' || c == '_' || c == '.' || c == '~') out += char(c);
      else { out += '%'; out += hex[c >> 4]; out += hex[c & 15]; }
    }
    return out;
  }
  void defaults() {
    memset(&cfg, 0, sizeof(cfg)); cfg.magic = CONFIG_MAGIC;
    randomText(cfg.setupCode, 16);
    copy(cfg.timezone, sizeof(cfg.timezone), "CET-1CEST,M3.5.0,M10.5.0/3");
    copy(cfg.location, sizeof(cfg.location), "Prague / local sensor");
    copy(cfg.feed, sizeof(cfg.feed), "https://feeds.bbci.co.uk/news/world/europe/rss.xml");
    cfg.latitude = 50.0755; cfg.longitude = 14.4378; cfg.radiusKm = 40;
    cfg.sensorSeconds = 60; cfg.transportSeconds = 60;
    cfg.aircraftSeconds = 30; cfg.newsSeconds = 3600;
    cfg.sleepEnabled = false;
  }
  bool validConfig(const Config &c) {
    return c.magic == CONFIG_MAGIC && memchr(c.ssid, 0, sizeof(c.ssid)) &&
      memchr(c.wifiPassword, 0, sizeof(c.wifiPassword)) && memchr(c.setupCode, 0, sizeof(c.setupCode)) &&
      strlen(c.setupCode) == 16 && memchr(c.timezone, 0, sizeof(c.timezone)) &&
      memchr(c.location, 0, sizeof(c.location)) && memchr(c.stop, 0, sizeof(c.stop)) &&
      memchr(c.token, 0, sizeof(c.token)) && memchr(c.feed, 0, sizeof(c.feed)) &&
      isfinite(c.latitude) && fabs(c.latitude) <= 90 && isfinite(c.longitude) && fabs(c.longitude) <= 180 &&
      isfinite(c.temperatureOffset) && fabs(c.temperatureOffset) <= 15 &&
      c.radiusKm >= 1 && c.radiusKm <= 150 && c.sensorSeconds >= 30 && c.sensorSeconds <= 1800 &&
      c.transportSeconds >= 30 && c.transportSeconds <= 600 &&
      c.aircraftSeconds >= 30 && c.aircraftSeconds <= 600 && c.newsSeconds >= 1800 && c.newsSeconds <= 86400;
