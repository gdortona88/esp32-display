  void scanNetworks() {
    if (!authorized()) return;
    int count = WiFi.scanComplete();
    if (count == WIFI_SCAN_FAILED) { WiFi.scanNetworks(true); server.send(200,"application/json","{\"busy\":true}"); return; }
    if (count == WIFI_SCAN_RUNNING) { server.send(200,"application/json","{\"busy\":true}"); return; }
    JsonDocument doc; auto list = doc["networks"].to<JsonArray>();
    for (int i=0; i<count && i<25; ++i) { auto n=list.add<JsonObject>(); n["ssid"]=WiFi.SSID(i); n["rssi"]=WiFi.RSSI(i); }
    String json; serializeJson(doc,json); WiFi.scanDelete(); server.send(200,"application/json",json);
  }
  bool number(const char *name, double low, double high, double &value, bool integer=false) {
    String s=server.arg(name); char *end=nullptr; value=strtod(s.c_str(),&end);
    return s.length() && end && !*end && isfinite(value) && value>=low && value<=high && (!integer || floor(value)==value);
  }
  void saveSettings() {
    if (!validPost()) return;
    Config next=cfg;
    const char *fields[]={"ssid","location","timezone","stop","feed"};
    char *dest[]={next.ssid,next.location,next.timezone,next.stop,next.feed};
    size_t sizes[]={sizeof(next.ssid),sizeof(next.location),sizeof(next.timezone),sizeof(next.stop),sizeof(next.feed)};
    for (int i=0;i<5;++i) {
      String s=server.arg(fields[i]);
      if (!server.hasArg(fields[i]) || s.length()>=sizes[i] || s.indexOf('\r')>=0 || s.indexOf('\n')>=0) { server.send(400,"text/plain","Missing, long, or invalid text field. Use browser Back."); return; }
      copy(dest[i],sizes[i],s.c_str());
    }
    String password=server.arg("password"), token=server.arg("token"), feed=next.feed;
    if (password.length()>64 || token.length()>=sizeof(next.token) || token.indexOf('\r')>=0 || token.indexOf('\n')>=0 || !next.timezone[0] || (feed.length() && (!feed.startsWith("https://") || feed.indexOf(' ')>=0))) { server.send(400,"text/plain","Invalid password, token, timezone, or HTTPS feed URL."); return; }
    if (strcmp(next.ssid,cfg.ssid) || server.hasArg("open")) next.wifiPassword[0]=0;
    if (password.length()) copy(next.wifiPassword,sizeof(next.wifiPassword),password.c_str());
    if (server.hasArg("open")) next.wifiPassword[0]=0;
    size_t pwlen=strlen(next.wifiPassword);
    if (pwlen && pwlen<8) { server.send(400,"text/plain","Wi-Fi password must contain at least 8 characters, or select open network."); return; }
    if (pwlen==64) for (size_t i=0;i<64;++i) if (!isxdigit(next.wifiPassword[i])) { server.send(400,"text/plain","A 64-character Wi-Fi key must be hexadecimal."); return; }
    if (token.length()) copy(next.token,sizeof(next.token),token.c_str());
    if (server.hasArg("clearToken")) next.token[0]=0;
    for (const char *p=next.timezone;*p;++p) if (!(isalnum((uint8_t)*p)||strchr("+-,:<>./",*p))) { server.send(400,"text/plain","Use a POSIX timezone, for example CET-1CEST,M3.5.0,M10.5.0/3."); return; }
    double value;
    if (!number("lat",-90,90,value)) { server.send(400,"text/plain","Invalid latitude"); return; } next.latitude=value;
    if (!number("lon",-180,180,value)) { server.send(400,"text/plain","Invalid longitude"); return; } next.longitude=value;
    if (!number("offset",-15,15,value)) { server.send(400,"text/plain","Invalid temperature correction"); return; } next.temperatureOffset=value;
    if (!number("radius",1,150,value,true)) { server.send(400,"text/plain","Invalid radius"); return; } next.radiusKm=value;
    if (!number("sensor",30,1800,value,true)) { server.send(400,"text/plain","Invalid sensor interval"); return; } next.sensorSeconds=value;
    if (!number("transport",30,600,value,true)) { server.send(400,"text/plain","Invalid transport interval"); return; } next.transportSeconds=value;
    if (!number("aircraft",30,600,value,true)) { server.send(400,"text/plain","Invalid aircraft interval"); return; } next.aircraftSeconds=value;
    if (!number("news",1800,86400,value,true)) { server.send(400,"text/plain","Invalid news interval"); return; } next.newsSeconds=value;
    next.sleepEnabled=false;
    time_t manual=0; String utc=server.arg("utc");
    if (utc.length()) { manual=parseIso(utc.c_str()); if (!manual) { server.send(400,"text/plain","Invalid UTC date/time. Example: 2026-09-14T18:30:00Z"); return; } }
    if (!validConfig(next) || preferences.putBytes("config",&next,sizeof(next)) != sizeof(next)) { server.send(500,"text/plain","Settings were not saved. NVS write failed."); return; }
    if(preferences.putBool("inverted",server.hasArg("inverted"))!=1){server.send(500,"text/plain","Display preference could not be saved; other settings were saved.");return;}
    if (manual) { timeval tv{manual,0}; settimeofday(&tv,nullptr); saveRtc(); }
    server.send(200,"text/html","<h2>Settings saved</h2><p>The dashboard is restarting and closing its setup network. If connection fails, hold BOOT for setup again.</p>");
    rebootAt=ms()+1800;
  }
  // ============================================================
  // OTA: AUTHENTICATED BROWSER UPLOAD INTO THE INACTIVE APP SLOT
  // ============================================================
  void uploadChunk() {
    auto &upload=server.upload();
    if (upload.status==UPLOAD_FILE_START) {
      uploadOK=false;
      uploadAuthorized=server.authenticate("admin",cfg.setupCode) && server.arg("nonce")==csrf;
      if (!uploadAuthorized) return;
      if(jobBusy||geoPending||geoRunning)return;
      if (!upload.filename.endsWith(".bin")) return;
      uploadStarted=ms(); uploadActive=Update.begin(UPDATE_SIZE_UNKNOWN,U_FLASH);
      dirty=true; render();
    } else if (upload.status==UPLOAD_FILE_WRITE && uploadActive) {
      if (ms()-uploadStarted>180000 || Update.write(upload.buf,upload.currentSize)!=upload.currentSize) { Update.abort(); uploadActive=false; }
    } else if (upload.status==UPLOAD_FILE_END && uploadActive) {
      uploadOK=Update.end(true); uploadActive=false; dirty=true;
    } else if (upload.status==UPLOAD_FILE_ABORTED) { Update.abort(); uploadActive=false; uploadOK=false; dirty=true; }
  }
  void finishUpload() {
    if (!uploadAuthorized) { server.send(403,"text/plain","Upload requires admin authentication and a current setup form."); return; }
    if (!uploadOK || Update.hasError()) { server.send(400,"text/plain","Firmware update failed. Use the exported application .bin for this board. The current firmware remains active."); return; }
    server.send(200,"text/html","<h2>Firmware uploaded</h2><p>Restarting now. Saved settings are retained.</p>"); rebootAt=ms()+1800;
  }
  void closePortal() {
    if (uploadActive) return;
    server.stop(); dns.stop(); WiFi.scanDelete(); WiFi.softAPdisconnect(true);
    geoPending=false;radioOff(); // Keep STA alive until any in-flight HTTPS request returns.
    portal=false; portalRequested=false; networkRetry=0; ntpAttempt=0;
    lastAction=ms(); copy(status,sizeof(status),"Setup closed"); dirty=true;
  }
  void startPortal() {
    portalRequested=false;
    snprintf(apName,sizeof(apName),"RLCD-Setup-%04X",(unsigned)(ESP.getEfuseMac()&0xFFFF));
    WiFi.mode(WIFI_AP_STA);
    if (!WiFi.softAP(apName,cfg.setupCode,1,false,2)) { copy(status,sizeof(status),"Setup AP failed; hold BOOT to retry"); WiFi.mode(WIFI_OFF); dirty=true; return; }
    portal=true; portalStarted=ms();
    if(cfg.ssid[0]){WiFi.setAutoReconnect(false);WiFi.begin(cfg.ssid,cfg.wifiPassword);connecting=true;connectStarted=ms();}
    dns.start(53,"*",WiFi.softAPIP()); server.begin(); dirty=true;
  }
  void setupRoutes() {
    server.on("/",HTTP_GET,[this](){portalPage();});
    server.on("/stops",HTTP_GET,[this](){if(authorized())server.send_P(200,"application/json; charset=utf-8",STOP_CATALOGUE);});
    server.on("/geocode",HTTP_POST,[this](){geoSearch();});
    server.on("/geocode",HTTP_GET,[this](){geoStatus();});
    server.on("/scan",HTTP_GET,[this](){scanNetworks();});
    server.on("/save",HTTP_POST,[this](){saveSettings();});
    server.on("/close",HTTP_POST,[this](){if(validPost()){server.send(200,"text/plain","Setup closed."); portalStarted=1;}});
    server.on("/update",HTTP_POST,[this](){finishUpload();},[this](){uploadChunk();});
    server.onNotFound([this](){
      if(server.method()!=HTTP_GET){server.send(404,"text/plain","Not found");return;}
      server.sendHeader("Location","http://192.168.4.1/",true);server.send(302,"text/plain","");
    });
  }

  // ============================================================
  // BUTTON HANDLING: DEBOUNCED EDGE EVENTS, LONG PRESS ONCE
  // ============================================================
  void buttonTick(Button &b, bool next) {
    uint64_t now=ms(); bool raw=digitalRead(b.pin)==LOW;
    if(raw!=b.raw){b.raw=raw;b.changed=now;lastAction=now;}
    if(now-b.changed>=35 && b.down!=b.raw){
      b.down=b.raw;
      if(b.down){b.pressed=now;b.held=false;}
      else if(!b.held && !portal && !portalRequested){
        app=(App)((app+(next?1:APP_COUNT-1))%APP_COUNT);alternate=false;carouselAt=now;dirty=true;
      }
    }
    if(b.down && !b.held && now-b.pressed>=(next?900:2500)){
      b.held=true;lastAction=now;
      if(!next){ if(portal)closePortal();else {portalRequested=true;copy(status,sizeof(status),"Opening setup after current request");dirty=true;} }
      else if(!portal){
        alternate=!alternate;dirty=true;
        if(app==AIRCRAFT){selectedPlane=cache[PLANES].result.count?(selectedPlane+1)%cache[PLANES].result.count:0;carouselAt=now;}
        // Manual refresh still respects minimum interval and server backoff.
        if(app==WEATHER && now-sensor.attempted>=30000)sampleSensor();
        if(app==SYSTEM)sampleBattery();
        int kind=app==TRANSPORT?DEPARTURES:app==AIRCRAFT?PLANES:app==NEWS?HEADLINES:-1;
        if(kind>=0 && !jobBusy){
          auto &c=cache[kind]; uint64_t minimum=(kind==HEADLINES?1800ULL:30ULL)*1000;
          if(now-c.attemptMs>=minimum && now>=c.retryMs)c.attemptMs=0;
        }
        if(app==CLOCK && now-ntpAttempt>=60000)ntpAttempt=0;
      }
    }
  }
public:
  void begin() {
    instance = this; Serial.begin(115200); setCpuFrequencyMhz(80);
    bootResetReason=(int)esp_reset_reason();
    pinMode(18, INPUT_PULLUP); pinMode(0, INPUT_PULLUP);
    pinMode(46, OUTPUT); digitalWrite(46, LOW); // Audio power amplifier disabled.
    Wire.begin(13, 14); Wire.setClock(100000); Wire.setTimeOut(30);
    analogReadResolution(12); analogSetPinAttenuation(4, ADC_11db);
    loadConfig(); restoreRtc(); lcd.begin(0, U8G2_R1); g = lcd.getU8g2(); lcd.setInverted(inverted);
    if (!g->getBufferPtr()) { Serial.println("Display buffer allocation failed"); return; }
    memset(previousFrame,0xFF,sizeof(previousFrame));
    // Initialize lwIP and its TCP/IP task/mailbox without starting the Wi-Fi
    // radio. This must precede SNTP calls, including the first portal's cleanup.
    tcpipReady = Network.begin();
    if (!tcpipReady) {
      copy(status,sizeof(status),"Network initialization failed"); app=SYSTEM;
      sampleBattery(); render(); return;
    }
    jobs=xQueueCreate(1,sizeof(Job)); results=xQueueCreate(1,sizeof(Result));
    if (!jobs || !results || xTaskCreatePinnedToCore(worker,"dashboard-net",16384,this,1,nullptr,0)!=pdPASS) {
      copy(status,sizeof(status),"Network worker allocation failed"); app=SYSTEM; sampleBattery(); render();
      // Keep a readable diagnostic instead of dereferencing a null queue.
      for(;;)delay(1000);
    }
    setupRoutes();
    copy(status,sizeof(status),"Ready; Wi-Fi scheduled on demand");
    // Nothing has started yet: there is no radio or NTP service to tear down.
    // First boot goes straight into configuration for up to ten minutes.
    if (!cfg.ssid[0]) startPortal();
    sampleSensor(); sampleBattery(); lastAction=ms(); render();
  }
  void tick() {
    if (!g || !g->getBufferPtr() || !jobs || !results) { delay(100); return; }
    buttonTick(nextButton,true); buttonTick(backButton,false);
    networkTick();
    if (portal) {
      dns.processNextRequest(); server.handleClient();
      if (uploadActive && ms()-uploadStarted>180000) { Update.abort();uploadActive=false;uploadOK=false;dirty=true; }
      if (!uploadActive && !rebootAt && (portalStarted==1 || ms()-portalStarted>600000))closePortal();
    }
    if (rebootAt && ms()>=rebootAt) ESP.restart();
    if (ms() - sensor.attempted >= uint64_t(cfg.sensorSeconds) * 1000) sampleSensor();
    if (ms() - lastBattery >= 60000) sampleBattery();
    if(!portal && app==AIRCRAFT && cache[PLANES].valid && cache[PLANES].result.count){
      if(ms()-carouselAt>=10000){selectedPlane=(selectedPlane+1)%cache[PLANES].result.count;carouselAt=ms();dirty=true;}
      if(ms()-animationAt>=500){animationAt=ms();dirty=true;}
    }
    uint32_t period=(app==TRANSPORT || app==SYSTEM)?5000:60000;
    if (ms() - lastUiTick >= period) { lastUiTick = ms(); dirty = true; }
    // Refresh clock on the local minute boundary, independent of boot time.
    static time_t minute=-1; time_t current=time(nullptr)/60;
    if(current!=minute){minute=current;if(app==CLOCK)dirty=true;}
    render(); idleSleep();
    if (ms()-lastDiagnostic >= 10000) {
      lastDiagnostic=ms();
      if (Serial) Serial.printf("RLCD %s uptime=%lus reset=%d stripWrites=%lu heap=%lu MCU-sleep=off\n",
        VERSION,(unsigned long)(ms()/1000),bootResetReason,(unsigned long)stripWrites,(unsigned long)ESP.getFreeHeap());
    }
  }
};

Dashboard dashboard;
void setup() { dashboard.begin(); }
void loop() { dashboard.tick(); }

