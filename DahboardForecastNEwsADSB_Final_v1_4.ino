      copy(plane.callsign, sizeof(plane.callsign), call.c_str()); copy(plane.type, sizeof(plane.type), a["t"] | "--");
      if (a["alt_baro"].is<long>()) snprintf(plane.altitude, sizeof(plane.altitude), "%ld ft", a["alt_baro"].as<long>());
      else copy(plane.altitude, sizeof(plane.altitude), a["alt_baro"] | "-- ft");
