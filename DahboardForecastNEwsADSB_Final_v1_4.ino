  static bool parsePlanes(char *body, size_t length, const Config &config, Result &r) {
    JsonDocument filter; auto f = filter["ac"][0];
    for (const char *field : {"hex","flight","t","alt_baro","lat","lon","track","seen_pos"}) f[field] = true;
    JsonMemory memory; JsonDocument doc(&memory);
    auto err = deserializeJson(doc, body, length, DeserializationOption::Filter(filter), DeserializationOption::NestingLimit(12));
    if (err || !doc["ac"].is<JsonArray>()) { copy(r.error, sizeof(r.error), "Invalid aircraft data"); return false; }
    for (JsonObject a : doc["ac"].as<JsonArray>()) {
      if (!a["lat"].is<double>() || !a["lon"].is<double>() || (a["seen_pos"] | 1e9) > 60) continue;
      double lat = a["lat"], lon = a["lon"];
      if (!isfinite(lat) || !isfinite(lon) || fabs(lat)>90 || fabs(lon)>180) continue;
      double p1 = config.latitude * DEG_TO_RAD, p2 = lat * DEG_TO_RAD;
      double dl = (lon-config.longitude) * DEG_TO_RAD, dp = p2-p1;
