  void font(bool large = false) { g->setFont(large ? u8g2_font_helvB18_tr : u8g2_font_unifont_t_extended); }
  void text(int x, int y, const String &s) { g->drawUTF8(x, y, s.c_str()); }
  void centered(int y, const String &s) { text((400 - g->getUTF8Width(s.c_str())) / 2, y, s); }
  String fit(String s, int width) {
    if (g->getUTF8Width(s.c_str()) <= width) return s;
    while (s.length() && g->getUTF8Width((s + "...").c_str()) > width) {
      size_t n = s.length() - 1; while (n && ((uint8_t)s[n] & 0xC0) == 0x80) --n; s.remove(n);
    }
    return s + "...";
  }
  void wrapped(int x, int y, String s, int width, int lines) {
    for (int line = 0; line < lines && s.length(); ++line) {
      if (g->getUTF8Width(s.c_str()) <= width) { text(x, y, s); return; }
      if (line == lines - 1) { text(x, y, fit(s, width)); return; }
      int end = 0, space = -1;
      for (unsigned i = 0; i < s.length(); ++i) {
        if (((uint8_t)s[i] & 0xC0) == 0x80) continue;
        if (g->getUTF8Width(s.substring(0, i + 1).c_str()) > width) break;
        end = i + 1; if (s[i] == ' ') space = i;
      }
      if (space > 0) end = space;
      if (end < 1) return;
      text(x, y, s.substring(0, end)); s = s.substring(end); s.trim(); y += 17;
    }
  }
