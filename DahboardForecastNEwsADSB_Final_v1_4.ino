</script>)JS";
    html += "<script>let pending=false;async function scan(){if(pending)return;pending=true;let t=document.getElementById('scanstate');t.textContent='Scanning...';try{let r=await fetch('/scan');let d=await r.json();if(d.busy){pending=false;setTimeout(scan,1800);return}let s=document.getElementById('networks');s.replaceChildren(new Option('Choose a network',''));d.networks.forEach(n=>s.add(new Option(n.ssid+' ('+n.rssi+' dBm)',n.ssid)));t.textContent='Choose a network or enter its name.'}catch(e){t.textContent='Scan failed; enter the SSID manually.'}pending=false}</script></html>";
    server.sendHeader("Cache-Control","no-store"); server.sendHeader("X-Frame-Options","DENY");
