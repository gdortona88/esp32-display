  String age(uint64_t stamp) {
    if (!stamp) return "never";
    uint64_t secs = (ms() - stamp) / 1000;
    if (secs < 60) return String((unsigned)secs) + "s";
    if (secs < 3600) return String((unsigned)(secs / 60)) + "m";
    return String((unsigned)(secs / 3600)) + "h";
  }
  uint32_t interval(JobKind kind) {
    return kind == DEPARTURES ? cfg.transportSeconds : kind == PLANES ? cfg.aircraftSeconds : kind == FORECAST ? 1800 : cfg.newsSeconds;
  }
  bool stale(JobKind kind) {
    auto &c = cache[kind]; return !c.valid || c.failures || ms() - c.successMs > uint64_t(interval(kind)) * 2000;
  }
  void cacheFooter(JobKind kind, const char *source) {
    auto &c = cache[kind]; font();
