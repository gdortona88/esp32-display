    text(12, 264, fit(c.error[0] ? String(c.error) : String("Hold KEY: next detail / refresh"), 375));
  }
  void homeDigit(int x,int y,int digit) {
    static const uint8_t masks[]={0x3F,0x06,0x5B,0x4F,0x66,0x6D,0x7D,0x07,0x7F,0x6F};
    uint8_t bits=digit<0?0x40:masks[digit];
    if(bits&1)g->drawRBox(x+6,y,26,6,2);
    if(bits&2)g->drawRBox(x+32,y+5,6,27,2);
    if(bits&4)g->drawRBox(x+32,y+38,6,27,2);
    if(bits&8)g->drawRBox(x+6,y+64,26,6,2);
    if(bits&16)g->drawRBox(x,y+38,6,27,2);
    if(bits&32)g->drawRBox(x,y+5,6,27,2);
    if(bits&64)g->drawRBox(x+6,y+32,26,6,2);
  }
