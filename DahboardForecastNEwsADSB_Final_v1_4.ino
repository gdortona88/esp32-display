      copy(r.error,sizeof(r.error),"Invalid address search response");return false;
    }
    auto features=doc["features"].as<JsonArray>();
    for(JsonObject f:features){
      auto coordinates=f["geometry"]["coordinates"];
      if(strcmp(f["geometry"]["type"]|"","Point") || !coordinates[0].is<double>() || !coordinates[1].is<double>())continue;
      double lon=coordinates[0],lat=coordinates[1];if(!isfinite(lat)||!isfinite(lon)||fabs(lat)>90||fabs(lon)>180)continue;
      auto prop=f["properties"];String label=prop["name"]|"",street=prop["street"]|"",house=prop["housenumber"]|"";
      if(street.length()){if(label.length() && !(label==street))label+=", ";else label="";label+=street;if(house.length())label+=" "+house;}
      if(!label.length())continue;
      for(const char *key:{"postcode","city","district","state","country"}){const char *value=prop[key];if(value&&value[0]){label+=", ";label+=value;}}
      // Keep UTF-8 intact when fitting the fixed-size queue result.
      size_t length=label.length();if(length>255){length=255;while(length && (uint8_t(label[length])&0xC0)==0x80)--length;}
      auto &out=r.data.places[r.count++];memcpy(out.label,label.c_str(),length);out.label[length]=0;out.latitude=lat;out.longitude=lon;
      if(r.count==5)break;
    }
    if(features.size()&&!r.count){copy(r.error,sizeof(r.error),"No usable address coordinates");return false;}return true;
  }
  static void worker(void *arg) {
    auto self = (Dashboard *)arg; Job job{};
    for (;;) {
      if (xQueueReceive(self->jobs,&job,portMAX_DELAY) != pdTRUE) continue;
      Result result{}; result.kind = job.kind; Body body; String url;
      if (job.kind == DEPARTURES)
        url = "https://api.golemio.cz/v2/pid/departureboards?names%5B%5D=" + urlEncode(job.config.stop) + "&includeMetroTrains=true&limit=6&minutesBefore=0&minutesAfter=60&order=real&mode=departures";
      else if (job.kind == PLANES)
        url = "https://api.adsb.lol/v2/point/" + String(job.config.latitude,6) + "/" + String(job.config.longitude,6) + "/" + String((int)ceil(job.config.radiusKm/1.852));
      else if(job.kind==FORECAST)url="https://api.open-meteo.com/v1/forecast?latitude="+String(job.config.latitude,6)+"&longitude="+String(job.config.longitude,6)+"&daily=weather_code,temperature_2m_max,temperature_2m_min,precipitation_probability_max&hourly=temperature_2m,precipitation_probability,weather_code,is_day&timezone=auto&timeformat=unixtime&forecast_days=3&forecast_hours=24";
      else if(job.kind==ROUTE){copy(result.data.route.callsign,sizeof(result.data.route.callsign),job.callsign);url="https://api.adsbdb.com/v0/callsign/"+urlEncode(job.callsign);}
      else if(job.kind==GEOCODE)url="https://photon.komoot.io/api/?limit=5&q="+urlEncode(job.query)+"&lat="+String(job.config.latitude,6)+"&lon="+String(job.config.longitude,6);
      else url = job.config.feed;
      if (fetch(url, job.kind == DEPARTURES ? job.config.token : nullptr, body, result)) {
        if (job.kind == DEPARTURES) result.ok = parseDepartures(body.bytes,body.length,result);
        else if (job.kind == PLANES) result.ok = parsePlanes(body.bytes,body.length,job.config,result);
        else if(job.kind==FORECAST)result.ok=parseForecast(body.bytes,body.length,result);
        else if(job.kind==ROUTE)result.ok=parseRoute(body.bytes,body.length,result);
        else if(job.kind==GEOCODE)result.ok=parsePlaces(body.bytes,body.length,result);
        else result.ok = parseNews(body.bytes,result);
      }
      xQueueSend(self->results,&result,portMAX_DELAY);
    }
  }

  // ============================================================
  // WIFI SCHEDULER: ACTIVE-APP REFRESH, BACKOFF, CACHED FAILURES
  // ============================================================
  int dueJob() {
    if (portal || portalRequested || !cfg.ssid[0]) return -1;
    auto due = [&](JobKind k) { auto &c=cache[k]; return ms()>=c.retryMs && (!c.attemptMs || ms()-c.attemptMs>=uint64_t(interval(k))*1000); };
    if (app == TRANSPORT && cfg.stop[0] && cfg.token[0] && due(DEPARTURES)) return DEPARTURES;
    if (app == AIRCRAFT && due(PLANES)) return PLANES;
    if ((app == CLOCK || app == WEATHER) && due(FORECAST)) return FORECAST;
    if(app==AIRCRAFT && nextRouteCallsign())return ROUTE;
    if (cfg.feed[0] && due(HEADLINES)) return HEADLINES;
    return -1;
  }
  void radioOff() {
    if (jobBusy || !tcpipReady) return;
    // esp_sntp_stop posts a callback to lwIP; it is not safe before TCP/IP
    // initialization. In particular, the initial portal has no SNTP to stop.
    if (ntpRunning) { esp_sntp_stop(); ntpRunning = false; }
    WiFi.disconnect(false,false); WiFi.mode(WIFI_OFF);
    networkUp = false; connecting = false; ntpSession = false; dirty = true;
  }
  void networkTick() {
    if (!tcpipReady) return;
    Result result{};
    if (xQueueReceive(results,&result,0) == pdTRUE) {
      jobBusy = false;
      if(result.kind==GEOCODE){
        geoResult=result;geoRunning=false;geoRetry=ms()+max(2000ULL,uint64_t(result.retryAfter)*1000);
      } else if(result.kind==ROUTE){
        acceptRoute(result);
      } else {
      auto &c = cache[result.kind];
      if (result.ok) {
        if(result.kind==PLANES && c.valid && c.result.count && result.count){
          const char *selected=c.result.data.planes[selectedPlane%c.result.count].callsign;
          uint8_t next=0;for(uint8_t i=0;i<result.count;++i)if(!strcmp(selected,result.data.planes[i].callsign)){next=i;break;}
          selectedPlane=next;
        }
        c.result = result; c.valid = true; c.successMs = ms(); c.failures = 0;
        c.error[0] = 0; c.retryMs = 0; lastNetworkSuccess = ms();
        copy(status,sizeof(status),"Update complete; Wi-Fi will sleep");
      } else {
        c.failures = c.failures < 8 ? c.failures+1 : 8; copy(c.error,sizeof(c.error),result.error);
        uint32_t backoff = min(900U,30U << min((unsigned)c.failures,5U));
        if (result.retryAfter > backoff) backoff = result.retryAfter;
        c.retryMs = ms()+uint64_t(backoff)*1000;
        copy(status,sizeof(status),result.error);
      }
      }
      dirty = true;
    }
    if (timeArrived.exchange(false)) {
      saveRtc(); lastNetworkSuccess = ms(); ntpSession = false; dirty = true;
      copy(status,sizeof(status),"Time synced; RTC saved");
    }
    if (portal) { portalNetworkTick(); return; }
    if (portalRequested) { if (!jobBusy) { radioOff(); startPortal(); } return; }
    if (!cfg.ssid[0]) return;
    if (connecting) {
      if (WiFi.status() == WL_CONNECTED) {
        connecting = false; networkUp = true; connectedAt = ms();
        lastRssi = WiFi.RSSI(); copy(lastIP,sizeof(lastIP),WiFi.localIP().toString().c_str());
        WiFi.setSleep(true);
        ntpSession = !ntpAttempt || ms()-ntpAttempt >= (timeValid()?21600000ULL:60000ULL);
        if (ntpSession) {
          ntpAttempt = ms();
          esp_sntp_set_time_sync_notification_cb(ntpCallback);
          configTzTime(cfg.timezone,"pool.ntp.org","time.cloudflare.com","time.google.com");
          ntpRunning = true;
        }
        copy(status,sizeof(status),"Connected; syncing / fetching"); dirty = true;
      } else if (ms()-connectStarted > 15000) {
        radioOff(); networkRetry = ms()+60000;
        copy(status,sizeof(status),"Wi-Fi unavailable; retry in 60s");
      }
      return;
    }
    if (networkUp) {
      if (jobBusy) return;
      if (WiFi.status() != WL_CONNECTED) { radioOff(); networkRetry=ms()+60000; copy(status,sizeof(status),"Wi-Fi disconnected"); return; }
      int kind = dueJob();
      // Keep this connection for the short gap between route-prefetch requests.
      // Long backoffs still power the radio down; no busy wait is introduced.
      if(kind<0 && app==AIRCRAFT && routeRetry>ms() && routeRetry-ms()<=2000 && nextRouteCallsign(false))return;
      // Allow NTP a bounded window before TLS when neither system nor RTC knows time.
      if (kind >= 0 && (timeValid() || ms()-connectedAt>=12000)) {
        Job job{}; job.kind=(JobKind)kind; job.config=cfg;
        if(kind==ROUTE){const char *call=nextRouteCallsign();if(!call)return;copy(job.callsign,sizeof(job.callsign),call);}
        if (xQueueSend(jobs,&job,0) == pdTRUE) { if(kind!=ROUTE)cache[kind].attemptMs=ms();else copy(routeInFlight,sizeof(routeInFlight),job.callsign); jobBusy=true; }
      } else if (ms()-connectedAt >= (ntpSession?12000:1000)) { radioOff(); copy(status,sizeof(status),"Wi-Fi off between updates"); }
      return;
    }
    uint64_t ntpInterval = timeValid() ? 21600000ULL : 60000ULL;
    if (ms()>=networkRetry && (dueJob()>=0 || !ntpAttempt || ms()-ntpAttempt>=ntpInterval)) {
      WiFi.mode(WIFI_STA); WiFi.setAutoReconnect(false); WiFi.begin(cfg.ssid,cfg.wifiPassword);
      connecting=true; connectStarted=ms(); copy(status,sizeof(status),"Connecting to Wi-Fi"); dirty=true;
    }
  }

  void portalNetworkTick() {
    if(connecting && WiFi.status()==WL_CONNECTED){
      connecting=false;networkUp=true;connectedAt=ms();WiFi.setSleep(true);
      if(!timeValid()){
        esp_sntp_set_time_sync_notification_cb(ntpCallback);
        configTzTime(cfg.timezone,"pool.ntp.org","time.cloudflare.com");ntpRunning=true;
      }
    } else if(connecting && ms()-connectStarted>15000){
      connecting=false;networkUp=false;WiFi.disconnect(false,false);
    }
    if(networkUp && WiFi.status()!=WL_CONNECTED)networkUp=false;
    if(!geoPending)return;
    if(networkUp && timeValid() && !jobBusy && !uploadActive){
      Job job{};job.kind=GEOCODE;job.config=cfg;copy(job.query,sizeof(job.query),geoQuery);
      if(xQueueSend(jobs,&job,0)==pdTRUE){geoPending=false;geoRunning=true;jobBusy=true;}
    } else if(ms()-geoStarted>30000){
      geoPending=false;geoResult.ok=false;
      copy(geoResult.error,sizeof(geoResult.error),networkUp?"Clock not synced; set UTC time or retry":"Home Wi-Fi unavailable; check saved Wi-Fi settings");
    }
  }
  void geoStatus() {
    if(!authorized())return;
    if(server.arg("id")!=String(geoId)){server.send(409,"application/json","{\"error\":\"Search changed; search again\"}");return;}
    JsonDocument doc;doc["id"]=geoId;doc["busy"]=geoPending||geoRunning;
    if(!geoPending&&!geoRunning){
      if(!geoResult.ok)doc["error"]=geoResult.error;
      auto list=doc["places"].to<JsonArray>();
      if(geoResult.ok)for(uint8_t i=0;i<geoResult.count;++i){auto &p=geoResult.data.places[i];auto item=list.add<JsonObject>();item["label"]=p.label;item["lat"]=p.latitude;item["lon"]=p.longitude;}
    }
    String json;serializeJson(doc,json);server.sendHeader("Cache-Control","no-store");server.send(200,"application/json",json);
  }
  void geoSearch() {
    if(!validPost())return;
    String q=server.arg("q");q.trim();
    auto error=[&](int code,const char *message){JsonDocument doc;doc["error"]=message;String json;serializeJson(doc,json);server.send(code,"application/json",json);};
    if(uploadActive||rebootAt||geoPending||geoRunning||jobBusy){error(409,"Another operation is in progress; try again shortly");return;}
    if(q.length()<3||q.length()>160||q.indexOf('\n')>=0||q.indexOf('\r')>=0){error(400,"Enter a street and city, between 3 and 160 bytes");return;}
    if(!cfg.ssid[0]){error(409,"Save your Wi-Fi settings first, then reopen setup to search for an address");return;}
    if(!(q==geoQuery)||!geoResult.ok){
      if(ms()<geoRetry){error(429,"Search is cooling down; please try later");return;}
      copy(geoQuery,sizeof(geoQuery),q.c_str());geoResult={};geoPending=true;geoStarted=ms();geoRetry=ms()+2000;++geoId;
      if(!networkUp&&!connecting){WiFi.begin(cfg.ssid,cfg.wifiPassword);connecting=true;connectStarted=ms();}
    }
    server.sendHeader("Cache-Control","no-store");server.send(202,"application/json",String("{\"id\":")+geoId+"}");
  }
  // ============================================================
  // CONFIGURATION PORTAL: PHYSICAL ACCESS, WPA2, AUTH, CSRF, NVS
