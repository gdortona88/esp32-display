  // ============================================================
  // RTC / CLOCK: PCF85063 AT 0x51, UTC IN HARDWARE
  // ============================================================
  bool readReg(uint8_t addr, uint8_t reg, uint8_t *data, uint8_t n) {
    Wire.beginTransmission(addr); Wire.write(reg);
    if (Wire.endTransmission(false) != 0) return false;
    if (Wire.requestFrom(addr, n) != n) return false;
    for (uint8_t i = 0; i < n; ++i) data[i] = Wire.read();
    return true;
  }
  bool writeReg(uint8_t addr, uint8_t reg, const uint8_t *data, uint8_t n) {
    Wire.beginTransmission(addr); Wire.write(reg); Wire.write(data, n);
    return Wire.endTransmission() == 0;
  }
  static int bcd(uint8_t n) { return (n >> 4) * 10 + (n & 15); }
  static uint8_t toBcd(int n) { return (n / 10) * 16 + n % 10; }
  static bool validBcd(uint8_t n) { return (n & 15) < 10 && (n >> 4) < 10; }
  static time_t utcEpoch(int y, int m, int d, int h, int min, int sec) {
    if (y < 2024 || y > 2099 || m < 1 || m > 12 || d < 1 || d > 31 || h < 0 || h > 23 || min < 0 || min > 59 || sec < 0 || sec > 59) return 0;
    // Gregorian civil date to days since 1970; independent of process timezone.
    int year = y - (m <= 2), era = year / 400;
    unsigned yo = year - era * 400;
    unsigned doy = (153 * (m + (m > 2 ? -3 : 9)) + 2) / 5 + d - 1;
    time_t t = ((int64_t)era * 146097 + yo * 365 + yo / 4 - yo / 100 + doy - 719468) * 86400 + h * 3600 + min * 60 + sec;
    struct tm check{}; gmtime_r(&t, &check);
    return check.tm_year + 1900 == y && check.tm_mon + 1 == m && check.tm_mday == d ? t : 0;
  }
  static time_t parseIso(const char *s) {
    if (!s) return 0;
    int y, m, d, h, mi, sec;
    if (sscanf(s, "%d-%d-%dT%d:%d:%d", &y, &m, &d, &h, &mi, &sec) != 6) return 0;
    time_t t = utcEpoch(y, m, d, h, mi, sec); if (!t || strlen(s) < 20) return 0;
    const char *z = s + 19;
    if (*z == '.') { ++z; while (isdigit(*z)) ++z; }
    if (*z == 'Z' && !z[1]) return t;
    int oh, om; char trailing;
    if ((*z == '+' || *z == '-') && sscanf(z + 1, "%d:%d%c", &oh, &om, &trailing) == 2 && oh <= 23 && om <= 59 && oh >= 0 && om >= 0)
      return t - (*z == '+' ? 1 : -1) * (oh * 3600 + om * 60);
    return 0;
  }
  void restoreRtc() {
    uint8_t r[7], ctrl;
    rtcPresent = readReg(0x51, 0, &ctrl, 1);
    if (!rtcPresent || (ctrl & 0x28) || !readReg(0x51, 4, r, 7) || (r[0] & 0x80)) return;
    r[0] &= 0x7F; r[1] &= 0x7F; r[2] &= 0x3F; r[3] &= 0x3F; r[5] &= 0x1F;
    for (int i : {0,1,2,3,5,6}) if (!validBcd(r[i])) return;
    time_t t = utcEpoch(2000 + bcd(r[6]), bcd(r[5]), bcd(r[3]), bcd(r[2]), bcd(r[1]), bcd(r[0]));
    if (t) { timeval tv{t, 0}; settimeofday(&tv, nullptr); rtcValid = true; }
  }
  void saveRtc() {
    if (!timeValid()) return;
    time_t now = time(nullptr); struct tm t{}; gmtime_r(&now, &t);
    uint8_t ctrl = 0; readReg(0x51, 0, &ctrl, 1); ctrl &= ~0x28;
    uint8_t stopped = ctrl | 0x20;
    uint8_t r[] = {toBcd(t.tm_sec), toBcd(t.tm_min), toBcd(t.tm_hour), toBcd(t.tm_mday), (uint8_t)t.tm_wday, toBcd(t.tm_mon + 1), toBcd(t.tm_year - 100)};
    bool ok = writeReg(0x51, 0, &stopped, 1);
    ok = writeReg(0x51, 4, r, 7) && ok;
    ok = writeReg(0x51, 0, &ctrl, 1) && ok; // Always attempt to restart oscillator.
    rtcPresent = ok; rtcValid = ok;
  }
  static void ntpCallback(struct timeval *) { if (instance) instance->timeArrived.store(true); }

  // ============================================================
  // WEATHER: SHTC3, CRC-CHECKED LOCAL MEASUREMENTS
  // ============================================================
  bool sensorCommand(uint16_t command) {
    Wire.beginTransmission(0x70); Wire.write(command >> 8); Wire.write(command & 255);
    return Wire.endTransmission() == 0;
  }
  static uint8_t crc8(const uint8_t *data) {
    uint8_t crc = 0xFF;
    for (int i = 0; i < 2; ++i) { crc ^= data[i]; for (int b = 0; b < 8; ++b) crc = (crc & 128) ? (crc << 1) ^ 0x31 : crc << 1; }
    return crc;
  }
  void sampleSensor() {
    sensor.attempted = ms();
    bool ok = sensorCommand(0x3517); delay(1);
    ok = sensorCommand(0x7866) && ok; delay(15); // No clock stretching, temperature first.
    uint8_t r[6]{};
    if (Wire.requestFrom((uint8_t)0x70, (uint8_t)6) != 6) ok = false;
    else for (auto &v : r) v = Wire.read();
    sensorCommand(0xB098); // Return to sleep on BOTH success and failure.
    ok = ok && crc8(r) == r[2] && crc8(r + 3) == r[5];
    sensor.failed = !ok;
    if (ok) {
      sensor.temperature = -45.f + 175.f * ((r[0] << 8) | r[1]) / 65536.f + cfg.temperatureOffset;
      sensor.humidity = 100.f * ((r[3] << 8) | r[4]) / 65536.f;
      sensor.minimum = isnan(sensor.minimum) ? sensor.temperature : fminf(sensor.minimum, sensor.temperature);
      sensor.maximum = isnan(sensor.maximum) ? sensor.temperature : fmaxf(sensor.maximum, sensor.temperature);
      sensor.history[sensor.head] = sensor.temperature; sensor.head = (sensor.head + 1) % 48;
      if (sensor.count < 48) ++sensor.count;
      sensor.sampled = ms();
    }
    if (app == CLOCK || app == WEATHER) dirty = true;
  }

  // ============================================================
  // POWER: RADIO DUTY CYCLE, 80 MHz, BATTERY ADC
  // ============================================================
  void sampleBattery() {
    uint32_t sum = 0; for (int i = 0; i < 8; ++i) sum += analogReadMilliVolts(4);
    batteryVoltage = sum * 0.003f / 8.f;
    static const float volts[] = {3.0,3.3,3.5,3.6,3.7,3.8,3.9,4.0,4.1,4.2};
    static const int levels[] = {0,3,8,15,30,50,65,80,92,100};
    batteryPercent = -1;
    if (batteryVoltage >= 2.5 && batteryVoltage <= 4.35) {
      batteryPercent = batteryVoltage <= volts[0] ? 0 : 100;
      for (int i = 1; i < 10; ++i) if (batteryVoltage < volts[i]) {
        batteryPercent = levels[i-1] + (batteryVoltage - volts[i-1]) / (volts[i] - volts[i-1]) * (levels[i] - levels[i-1]); break;
      }
    }
    lastBattery = ms(); dirty = true;
  }
  void idleSleep() {
    // Stay awake while diagnosing board-specific blanking. A normal RTOS delay
    // yields CPU time without changing peripheral/GPIO sleep state.
    delay(5);
  }

