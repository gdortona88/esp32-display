while(Date.now()<deadline){await pause(1000);let response=await fetch('/geocode?id='+id,{cache:'no-store'});d=await response.json();if(!response.ok||d.error)throw Error(d.error||'Search failed');if(d.busy)continue;places=d.places||[];places.forEach((p,i)=>el('addresses').add(new Option(p.label,String(i))));el('addresses').selectedIndex=-1;el('addressstate').textContent=places.length?'Select the matching address, then Use this location.':'No matching address. Try the street, house number and city.';return}throw Error('Search timed out. Check the saved Wi-Fi and try again.')
}catch(e){el('addressstate').textContent=e.message||'Connection lost; reconnect to the setup network.'}finally{addressBusy=false;el('addresssearch').disabled=false}}
function fitBytes(s,max){let out='';for(let ch of s){if(new TextEncoder().encode(out+ch).length>max)break;out+=ch}return out}
async function useLocation(){let index=el('addresses').selectedIndex;if(index<0||!places[index])return;let p=places[index];field('lat').value=p.lat.toFixed(6);field('lon').value=p.lon.toFixed(6);field('location').value=fitBytes(p.label,64);
el('stopquery').value='';el('nearby').checked=true;el('stopmode').value='';field('stop').value='';el('uselocation').disabled=true;
