  bool authorized() {
    if (server.authenticate("admin",cfg.setupCode)) return true;
    server.requestAuthentication(BASIC_AUTH,"Reflective Dashboard","Use admin and the setup code shown on the LCD.");
    return false;
  }
  bool validPost() {
    if (!authorized()) return false;
    if (server.arg("nonce") != csrf) { server.send(403,"text/plain","Invalid form token. Reload setup."); return false; }
    return true;
  }
